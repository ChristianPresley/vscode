{
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "node10",
		"target": "es2022",
		"lib": [
			"es2022"
		],
		"strict": true,
		"noUnusedLocals": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0",
		"rootDir": "src",
		"outDir": "out",
		"typeRoots": [
			"../../../node_modules/@types"
		],
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*.ts",
		"../../../src/vscode-dts/vscode.d.ts",
		"../../../src/vscode-dts/vscode.proposed.chatParticipantAdditions.d.ts",
		"../../../src/vscode-dts/vscode.proposed.chatParticipantPrivate.d.ts",
		"../../../src/vscode-dts/vscode.proposed.mcpGrpcServerDefinition.d.ts",
		"../../../src/vscode-dts/vscode.proposed.mcpServerDefinitions.d.ts"
	]
}
