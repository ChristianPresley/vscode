{
	"name": "mcp-e2e",
	"publisher": "vscode-e2e",
	"displayName": "MCP end-to-end (llama.cpp)",
	"description": "Drives VS Code's MCP client with a llama.cpp model in the end-to-end tests of test/mcp-e2e.",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished",
		"onLanguageModelChatProvider:llamacpp"
	],
	"enabledApiProposals": [
		"chatParticipantAdditions",
		"chatParticipantPrivate",
		"mcpGrpcServerDefinition",
		"mcpServerDefinitions"
	],
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "llamacpp",
				"displayName": "llama.cpp (E2E)"
			}
		],
		"mcpServerDefinitionProviders": [
			{
				"id": "e2e-grpc",
				"label": "E2E gRPC provider"
			}
		]
	}
}
